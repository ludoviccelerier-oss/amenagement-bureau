---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { abs, editeur } from '../lib/schema';
import { getImage } from 'astro:assets';
import { photo } from '../lib/photos';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  image?: string; // nom d'une photo de src/assets/photos
}
const { title, description, type = 'website', schema = [], noindex = false, image } = Astro.props;
const canonical = abs(Astro.url.pathname.replace(/\/$/, '') || '/');
const og = image ? abs((await getImage({ src: photo(image), width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src) : abs('/og.png');

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#site`,
  name: site.nom,
  alternateName: site.domaine,
  description: site.description,
  url: site.url,
  inLanguage: 'fr-FR',
  publisher: editeur,
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1E2A3A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Résumé pour assistants IA" />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>
