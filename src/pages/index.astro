---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CarteGuide from '../components/CarteGuide.astro';
import Photo from '../components/Photo.astro';
import { rubriques, site } from '../data/site';
import { guidesDe, guidesTries } from '../lib/guides';
import { photo } from '../lib/photos';

const derniers = (await guidesTries()).slice(0, 6);
const comptes = Object.fromEntries(await Promise.all(rubriques.map(async (r) => [r.id, (await guidesDe(r.id)).length])));
---
<Base title={`Aménagement de bureaux : le guide pratique pour les entreprises et les bailleurs | ${site.nom}`} description={site.description} image="accueil">
  <div class="conteneur">
    <section class="une">
      <div>
        <span class="surtitre">Le guide pratique, sans jargon</span>
        <h1>L'aménagement de bureaux, <span class="surligne">expliqué simplement</span></h1>
        <p class="chapo">
          Vous déménagez, vous réorganisez un plateau, ou vous devez remettre en état un immeuble pour le relouer ?
          Nos guides répondent aux questions des dirigeants, des directeurs immobiliers et des bailleurs :
          par où commencer, combien prévoir, comment financer, qui choisir, qui paie quoi et comment le traiter en comptabilité.
        </p>
        <p class="acces">
          <a href="/guides/amenager-ses-bureaux-par-ou-commencer">Vous occupez des bureaux →</a>
          <a href="/rubriques/bailleurs">Vous êtes propriétaire bailleur →</a>
        </p>
      </div>
      <Photo nom="accueil" alt="Plateau de bureaux lumineux avec postes de travail et grandes baies vitrées" classe="photo une-photo" prioritaire sizes="(min-width: 64rem) 34rem, 100vw" />
    </section>

    <section class="section">
      <h2>{rubriques.length} rubriques pour tout comprendre</h2>
      <div class="grille-cartes">
        {rubriques.map((r, i) => (
          <a class="carte avec-image" href={`/rubriques/${r.id}`}>
            <Image src={photo(r.photo)} alt="" widths={[400, 640]} sizes="(min-width: 48rem) 22rem, 100vw" format="webp" quality={68} class="carte-image" />
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{r.titre}</h3>
            <p>{r.intro}</p>
            <span class="meta">{comptes[r.id]} guide{comptes[r.id] > 1 ? 's' : ''}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <h2>Derniers guides mis à jour</h2>
      <div class="grille-cartes">{derniers.map((g) => <CarteGuide guide={g} />)}</div>
      <p style="margin-top:1.5rem"><a href="/guides">Voir tous les guides →</a></p>
    </section>
  </div>
</Base>
