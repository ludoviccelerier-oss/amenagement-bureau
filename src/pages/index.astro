---
import Base from '../layouts/Base.astro';
import CarteGuide from '../components/CarteGuide.astro';
import { rubriques, site } from '../data/site';
import { guidesDe, guidesTries } from '../lib/guides';

const derniers = (await guidesTries()).slice(0, 6);
const comptes = Object.fromEntries(await Promise.all(rubriques.map(async (r) => [r.id, (await guidesDe(r.id)).length])));
---
<Base title={`Aménagement de bureaux : le guide pratique pour les entreprises | ${site.nom}`} description={site.description}>
  <div class="conteneur">
    <section class="une">
      <span class="surtitre">Le guide pratique, sans jargon</span>
      <h1>L'aménagement de bureaux, <span class="surligne">expliqué simplement</span></h1>
      <p class="chapo">
        Vous déménagez, vous réorganisez un plateau, ou votre bail vous impose des travaux ?
        Nos guides répondent aux questions que se posent les dirigeants et les directeurs immobiliers :
        par où commencer, combien prévoir, comment financer, qui choisir, et comment le traiter en comptabilité.
      </p>
      <p><a href="/guides/amenager-ses-bureaux-par-ou-commencer">Commencer par le guide de départ →</a></p>
    </section>

    <section class="section">
      <h2>Six rubriques pour tout comprendre</h2>
      <div class="grille-cartes">
        {rubriques.map((r, i) => (
          <a class="carte" href={`/rubriques/${r.id}`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{r.titre}</h3>
            <p>{r.intro}</p>
            <span class="meta">{comptes[r.id]} guide{comptes[r.id] > 1 ? 's' : ''}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <h2>Derniers guides mis à jour</h2>
      <div class="grille-cartes">{derniers.map((g) => <CarteGuide guide={g} />)}</div>
      <p style="margin-top:1.5rem"><a href="/guides">Voir tous les guides →</a></p>
    </section>
  </div>
</Base>
