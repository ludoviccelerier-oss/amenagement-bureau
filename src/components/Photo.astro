---
import { Image } from 'astro:assets';
import { photo, credit } from '../lib/photos';
interface Props { nom: string; alt: string; classe?: string; prioritaire?: boolean; sizes?: string; ratio?: number }
const { nom, alt, classe = 'photo', prioritaire = false, sizes = '(min-width: 64rem) 42rem, 100vw', ratio } = Astro.props;
// Avec un ratio, l'image est recadrée au build : on ne télécharge pas les pixels que le CSS masquerait
const cadre = ratio ? { width: 1600, height: Math.round(1600 / ratio), fit: 'cover' as const } : {};
const c = credit(nom);
---
<figure class={classe}>
  <Image src={photo(nom)} alt={alt} {...cadre} widths={[480, 800, 1200, 1600]} sizes={sizes} format="webp" quality={60}
    loading={prioritaire ? 'eager' : 'lazy'} fetchpriority={prioritaire ? 'high' : undefined} />
  {c && <figcaption>Photo : {c.auteur}, <a href={c.source} rel="noopener">{c.licence}</a>, Wikimedia Commons</figcaption>}
</figure>
