---
import { urlGuide, tempsLecture, type Guide } from '../lib/guides';
import { rubrique } from '../data/site';
interface Props { guide: Guide; numero?: number }
const { guide, numero } = Astro.props;
---
<a class="carte" href={urlGuide(guide)}>
  {numero !== undefined && <span class="num">{String(numero).padStart(2, '0')}</span>}
  <h3>{guide.data.title}</h3>
  <p>{guide.data.description}</p>
  <span class="meta">{rubrique(guide.data.rubrique).nom} · {tempsLecture(guide)} min de lecture</span>
</a>
